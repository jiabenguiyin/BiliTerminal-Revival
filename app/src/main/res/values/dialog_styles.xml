<resources>
    <style name="TerminalAlertDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/background_terminal_dialog</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:colorBackground">#262626</item>
        <item name="android:colorForeground">#ffffff</item>
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textColorSecondary">#dddddd</item>
        <item name="colorAccent">#ffffff</item>
        <item name="colorControlActivated">#ffffff</item>
        <item name="dialogPreferredPadding">12dp</item>
        <item name="buttonBarPositiveButtonStyle">@style/TerminalDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TerminalDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/TerminalDialogButton</item>
        <item name="textAppearanceListItem">@style/TerminalDialogListText</item>
        <item name="textAppearanceListItemSmall">@style/TerminalDialogListText</item>
    </style>
    <style name="TerminalDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/background_button_compat</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
    <style name="TerminalDialogListText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
