<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_test"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true">


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deepseek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical|right"
                    android:text="DeepSeek 猫娘对话测试"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/developer_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical|right"
                    android:text="作者的主页"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="如果你不是开发者，你不需要知道这个页面是用来干什么的。\n——当然，知道一点也无妨，这是一个简易的网络请求工具。"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/input_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_edittext"
                    android:hint="在这里输入请求链接"
                    android:minHeight="40dp"
                    android:paddingLeft="8dp"
                    android:paddingTop="8dp"
                    android:paddingRight="48dp"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/deepseek_toggle_key_visibility"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical|right"
                    android:background="@drawable/background_button_compat"
                    android:contentDescription="显示密钥"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:visibility="gone" />
            </FrameLayout>

            <EditText
                android:id="@+id/input_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/background_edittext"
                android:hint="在这里输入POST数据"
                android:minHeight="40dp"
                android:padding="8dp"
                android:text=""
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/deepseek_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageButton
                    android:id="@+id/deepseek_forget_key"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"
                    android:background="@drawable/background_button_compat"
                    android:contentDescription="清除密钥"
                    app:srcCompat="@drawable/icon_delete" />
                <ImageButton
                    android:id="@+id/deepseek_reset_chat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"
                    android:background="@drawable/background_button_compat"
                    android:contentDescription="清空对话"
                    app:srcCompat="@drawable/icon_refresh" />
            </LinearLayout>

            <TextView
                android:id="@+id/deepseek_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_wbi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:text="启用WBI签名" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_post"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:text="使用POST方式" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_deepseek_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:text="使用 DeepSeek V4 Pro（默认 Flash）"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/request_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical|right"
                    android:text="Go Request!"
                    android:textSize="13sp"
                    android:visibility="visible"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cookies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35sp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical|right"
                    android:text="查看Cookies"
                    android:textSize="13sp"
                    android:visibility="visible"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/output_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/background_edittext"
                android:hint="这里会输出请求结果"
                android:minHeight="40dp"
                android:padding="8dp"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>

    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
