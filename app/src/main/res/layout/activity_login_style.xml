<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="手机号/邮箱"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/loginStyleAccount"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/background_login_field"
            android:hint="手机号/邮箱"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/textwhite"
            android:textColorHint="#997A6A74"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="密码"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/loginStylePassword"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/background_login_field"
            android:hint="输入密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/textwhite"
            android:textColorHint="#997A6A74"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginStyleSubmit"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="登录  &gt;"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginStyleSms"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="短信验证码登录  &gt;"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/loginStyleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="密码登录需要完成一次官方安全验证"
            android:textSize="11sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginStyleQr"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="二维码登录"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginStyleIntl"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="国际站邮箱登录"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginStyleImport"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="其他设备导入"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginStyleOfficial"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="网页登录备用"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
