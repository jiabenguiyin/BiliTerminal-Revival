<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/cell_topbar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/add_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="添加账号"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/icon_person" />
    </com.google.android.material.card.MaterialCardView>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/account_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/add_account"
        android:layout_below="@id/top"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <TextView
        android:id="@+id/account_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/add_account"
        android:layout_below="@id/top"
        android:gravity="center"
        android:text="暂无已保存账号"
        android:visibility="gone" />
</RelativeLayout>
