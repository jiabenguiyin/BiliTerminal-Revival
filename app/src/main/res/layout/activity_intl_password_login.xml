<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="国际站使用官方 BiliBili TV 登录接口。主站账号和国际站账号分开保存。"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/intlLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="国际站邮箱"
            android:inputType="textEmailAddress"
            android:maxLines="1" />

        <EditText
            android:id="@+id/intlLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="国际站密码"
            android:inputType="textPassword"
            android:maxLines="1" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/intlLoginSubmit"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="登录国际站"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/intlLoginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="不会把密码写入日志、剪贴板或主站账号。"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/intlLoginOfficial"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="打开国际站官方页面"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
