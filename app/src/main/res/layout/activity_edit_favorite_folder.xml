<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/top" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_alignParentTop="true">
        <TextView android:id="@+id/pageName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_toLeftOf="@id/timeText"
            android:layout_marginLeft="8dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"
            android:lines="1" android:textStyle="bold" app:drawableStartCompat="@drawable/arrow_back" />
        <com.RobinNotBad.BiliClient.ui.widget.TextClock android:id="@+id/timeText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentRight="true" android:layout_marginRight="8dp"
            android:layout_marginTop="3dp" android:layout_marginBottom="3dp" />
    </RelativeLayout>
    <ScrollView android:id="@+id/folder_edit_scroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_below="@id/top" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp" android:focusableInTouchMode="true">
            <TextView android:id="@+id/folder_edit_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12sp" />
            <Button android:id="@+id/folder_edit_retry" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="重新读取" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="名称" />
            <EditText android:id="@+id/folder_edit_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="收藏夹名称" android:inputType="text"
                android:singleLine="true" android:maxLength="20" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="简介" />
            <EditText android:id="@+id/folder_edit_intro" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="收藏夹简介" android:inputType="textMultiLine"
                android:minLines="2" android:maxLines="5" android:maxLength="200" />
            <Switch android:id="@+id/folder_edit_private" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="44dp" android:text="私密收藏夹" />
            <Button android:id="@+id/folder_edit_save" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="保存" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
