<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:baselineAligned="false"
    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
    android:layout_marginVertical="@dimen/list_margin_vertical">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginRight="2dp">
        <TextView android:id="@+id/text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="42dp" android:gravity="center_vertical" android:padding="6dp"
            android:text="@string/user_video_series" android:textSize="12sp" android:maxLines="2"
            android:ellipsize="end" android:clickable="true" android:focusable="true"
            android:background="@drawable/background_button_compat" app:drawableEndCompat="@drawable/arrow_forward" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginLeft="2dp">
        <TextView android:id="@+id/user_video_sort" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="42dp" android:gravity="center_vertical" android:padding="6dp"
            android:text="@string/user_video_sort_newest" android:textSize="12sp" android:maxLines="2"
            android:ellipsize="end" android:clickable="true" android:focusable="true"
            android:background="@drawable/background_button_compat" app:drawableEndCompat="@drawable/icon_sort_expand" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
