<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    tools:context=".activity.message.MessageActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:id="@+id/message_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/pageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/pagename_message"
                android:textStyle="bold"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeStepGranularity="1sp"
                app:drawableStartCompat="@drawable/arrow_down" />

            <LinearLayout
                android:id="@+id/message_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/mark_all_read"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="7dp"
                    android:background="@drawable/background_message_action"
                    android:contentDescription="@string/message_mark_all_read"
                    app:srcCompat="@drawable/icon_message_read" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/setting_btn"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="7dp"
                    android:background="@drawable/background_message_action"
                    android:contentDescription="消息设置"
                    app:srcCompat="@drawable/icon_message_settings" />
            </LinearLayout>
            <View
                android:id="@+id/message_heading_balance"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:layout_centerVertical="true"
            android:gravity="center_vertical|right"
            android:textSize="12sp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <com.RobinNotBad.BiliClient.ui.widget.RotaryNestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/empty"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/activity_padding_horizontal"
                    android:paddingVertical="2dp"
                    android:showDividers="middle">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/reply"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/reply_go"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="9dp"
                                android:src="@drawable/arrow_forward"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/reply_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/icon_reply"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintHeight_percent="0.4"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="0.5" />

                            <TextView
                                android:id="@+id/reply_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:lines="1"
                                android:text="回复我的"
                                android:textColor="#fff"
                                android:textSize="12sp"
                                app:layout_constraintBottom_toBottomOf="@id/reply_icon"
                                app:layout_constraintEnd_toStartOf="@+id/reply_go"
                                app:layout_constraintStart_toEndOf="@+id/reply_icon"
                                app:layout_constraintTop_toTopOf="@id/reply_icon" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/at"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/at_go"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="9dp"
                                android:src="@drawable/arrow_forward"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/at_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/icon_at"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintHeight_percent="0.4"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="0.5" />

                            <TextView
                                android:id="@+id/at_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:lines="1"
                                android:text="\@我"
                                android:textColor="#fff"
                                android:textSize="12sp"
                                app:layout_constraintBottom_toBottomOf="@id/at_icon"
                                app:layout_constraintEnd_toStartOf="@+id/at_go"
                                app:layout_constraintStart_toEndOf="@+id/at_icon"
                                app:layout_constraintTop_toTopOf="@id/at_icon" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/like"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/like_go"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="9dp"
                                android:src="@drawable/arrow_forward"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/like_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/icon_reply_like0"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintHeight_percent="0.4"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="0.5" />

                            <TextView
                                android:id="@+id/like_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:lines="1"
                                android:text="收到的赞"
                                android:textColor="#fff"
                                android:textSize="12sp"
                                app:layout_constraintBottom_toBottomOf="@id/like_icon"
                                app:layout_constraintEnd_toStartOf="@+id/like_go"
                                app:layout_constraintStart_toEndOf="@+id/like_icon"
                                app:layout_constraintTop_toTopOf="@id/like_icon" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/system"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/system_go"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:layout_marginRight="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="9dp"
                                android:src="@drawable/arrow_forward"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/system_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/icon_info"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintHeight_percent="0.4"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="0.5" />

                            <TextView
                                android:id="@+id/system_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:lines="1"
                                android:text="系统通知"
                                android:textColor="#fff"
                                android:textSize="12sp"
                                app:layout_constraintBottom_toBottomOf="@id/system_icon"
                                app:layout_constraintEnd_toStartOf="@+id/system_go"
                                app:layout_constraintStart_toEndOf="@+id/system_icon"
                                app:layout_constraintTop_toTopOf="@id/system_icon" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:id="@+id/private_sessions_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/message_private_sessions" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/private_sessions_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/private_sessions_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/private_sessions_retry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:padding="6dp"
                        android:gravity="center"
                        android:background="@drawable/background_button_compat"
                        android:text="@string/message_private_retry"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                    android:id="@+id/sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>

        </com.RobinNotBad.BiliClient.ui.widget.RotaryNestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


</RelativeLayout>
