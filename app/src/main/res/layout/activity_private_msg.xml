<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/msg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="40dp" />

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bgblack">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_private_message"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/layout_input"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bgblack"
        android:paddingBottom="4dp">

        <HorizontalScrollView
            android:id="@+id/image_preview_container"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#1c1c1c"
            android:fillViewport="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/image_preview_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/message_input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

        <EditText
            android:id="@+id/msg_input_et"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:background="@drawable/background_edittext_privatemsg"
            android:hint="@string/hint_private_message"
            android:maxLines="3"
            android:maxHeight="80dp"
            android:minWidth="0dp"
            android:minHeight="38dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="top|start"
            android:textColor="@color/textwhite"
            android:textColorHint="#80ffffff"
            android:textCursorDrawable="@drawable/cursor_drawable"
            android:textSize="13sp"
            android:inputType="textMultiLine" />

        <ImageButton
            android:id="@+id/pick_image_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginRight="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/background_button_compat"
            android:contentDescription="选择图片"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_gallery" />

        <ImageButton
            android:id="@+id/send_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/background_privatemsg_send"
            android:contentDescription="发送私信"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/send" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
