<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/library_search_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:focusableInTouchMode="true">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/library_keyword"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:background="@drawable/background_searchbar"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:textSize="13sp"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionSearch" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/library_clear"
        android:layout_width="32dp"
        android:layout_height="42dp"
        android:padding="7dp"
        android:background="@android:color/transparent"
        android:visibility="invisible"
        android:contentDescription="@string/library_clear_search"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/library_search"
        android:layout_width="36dp"
        android:layout_height="42dp"
        android:padding="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/library_search"
        app:srcCompat="@drawable/icon_search" />
</LinearLayout>
